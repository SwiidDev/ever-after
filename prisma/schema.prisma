generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COUPLE
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  role      Role     @default(COUPLE)
  vendor    Vendor?
  couple    Couple?
  createdAt DateTime @default(now())
}

model Vendor {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  businessName   String
  slug           String       @unique
  category       String
  description    String?
  logoUrl        String?
  galleryUrls    String[]
  baseRegion     String
  baseLat        Decimal?
  baseLng        Decimal?
  status         VendorStatus @default(PENDING)
  ratingAvg      Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount    Int          @default(0)
  creditBalance  Int          @default(0)
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  serviceRegions ServiceRegion[]
  reviews        Review[]
  leadSlots      LeadSlot[]
  leadUnlocks    LeadUnlock[]
  ledgerEntries  LedgerEntry[]
}

model ServiceRegion {
  id        String @id @default(cuid())
  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  regionCode String
  radiusKm  Int
  lat       Decimal
  lng       Decimal

  @@unique([vendorId, regionCode])
}

model Couple {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  weddingDate  DateTime?
  region       String?
  budgetTotal  Decimal?
  partnerNames Json?
  guests       Guest[]
  budgetItems  BudgetItem[]
  checklist    ChecklistItem[]
  ideas        Idea[]
}

model Review {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  leadId    String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// ---- Lead engine ----

enum LeadStatus {
  DISTRIBUTED
  EXHAUSTED
  CLOSED
}

model Lead {
  id            String     @id @default(cuid())
  category      String
  eventDate     DateTime?
  region        String
  budgetBand    String
  guestCount    Int?
  contactName   String
  contactEmail  String
  contactPhone  String
  notes         String?
  status        LeadStatus @default(DISTRIBUTED)
  maxSlots      Int        @default(5)
  createdAt     DateTime   @default(now())
  slots         LeadSlot[]
  unlocks       LeadUnlock[]
}

model LeadSlot {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  position  Int
  notified  Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@unique([leadId, vendorId])
}

model LeadUnlock {
  id            String       @id @default(cuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id])
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  ledgerEntryId String       @unique
  createdAt     DateTime     @default(now())

  @@unique([leadId, vendorId])
}

// ---- Billing ----

enum LedgerType {
  PURCHASE
  BONUS
  UNLOCK
  REFUND
  ADMIN_ADJUSTMENT
  EXPIRY
}

model LedgerEntry {
  id             String     @id @default(cuid())
  vendorId       String
  vendor         Vendor     @relation(fields: [vendorId], references: [id])
  type           LedgerType
  deltaCredits   Int
  balanceAfter   Int
  idempotencyKey String     @unique
  refId          String?
  note           String?
  createdAt      DateTime   @default(now())

  @@index([vendorId, createdAt])
}

model CreditBundle {
  id         String  @id @default(cuid())
  name       String
  credits    Int
  priceCents Int
  active     Boolean @default(true)
}

model Payment {
  id             String   @id @default(cuid())
  vendorId       String
  bundleId       String?
  amountCents    Int
  status         String   @default("PENDING") // PENDING/COMPLETE/CANCELLED/FAILED
  pfPaymentId    String?  @unique
  creditsGranted Int      @default(0)
  createdAt      DateTime @default(now())
}

// ---- Couple planning tools ----

enum Event {
  WEDDING
  BRIDAL_SHOWER
  BACHELORS
}

enum Rsvp {
  PENDING
  ATTENDING
  DECLINED
}

model Guest {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  event     Event    @default(WEDDING)
  name      String
  phone     String?
  email     String?
  rsvp      Rsvp     @default(PENDING)
  needsRoom Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([coupleId, event])
}

model BudgetItem {
  id             String  @id @default(cuid())
  coupleId       String
  couple         Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  category       String
  description    String
  estimatedCents Int
  actualCents    Int     @default(0)
  paid           Boolean @default(false)

  @@index([coupleId, category])
}

model ChecklistItem {
  id        String  @id @default(cuid())
  coupleId  String
  couple    Couple  @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  monthsOut Int
  title     String
  done      Boolean @default(false)

  @@index([coupleId, monthsOut])
}

model Idea {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  title     String
  note      String?
  imageUrl  String?
  tags      String[]
  createdAt DateTime @default(now())
}
